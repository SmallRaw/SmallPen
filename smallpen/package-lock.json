{
  "name": "@smallpen/workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@smallpen/workspace",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/background": {
      "name": "@smallpen/background",
      "version": "0.1.0",
      "dependencies": {
        "@smallpen/core": "0.1.0",
        "@smallpen/local-package": "0.1.0",
        "@smallpen/penpot-adapter": "0.1.0"
      },
      "bin": {
        "smallpen-background": "bin/smallpen-background.mjs"
      }
    },
    "apps/cli": {
      "name": "@smallpen/cli",
      "version": "0.1.0",
      "dependencies": {
        "@smallpen/core": "0.1.0",
        "@smallpen/local-package": "0.1.0"
      },
      "bin": {
        "smallpen": "bin/smallpen-check.cjs"
      }
    },
    "apps/npm-cli": {
      "name": "smallpen",
      "version": "0.1.0",
      "dependencies": {
        "@smallpen/cli": "0.1.0"
      },
      "bin": {
        "smallpen": "bin/smallpen.cjs"
      }
    },
    "apps/desktop": {
      "name": "@smallpen/desktop",
      "version": "0.1.0",
      "dependencies": {
        "@smallpen/background": "0.1.0",
        "@smallpen/web": "0.1.0"
      },
      "bin": {
        "smallpen-desktop": "bin/smallpen-desktop.mjs",
        "smallpen-desktop-host": "bin/desktop-host.mjs"
      }
    },
    "apps/web": {
      "name": "@smallpen/web",
      "version": "0.1.0",
      "bin": {
        "smallpen-web": "bin/smallpen-web.mjs"
      }
    },
    "node_modules/@jsquash/webp": {
      "version": "1.5.0",
      "resolved": "https://registry.npmjs.org/@jsquash/webp/-/webp-1.5.0.tgz",
      "integrity": "sha512-KggLoj2MnRSfIqTeKe1EmbljTX2vuV7mh79k89PCL1pyqiDULcPM1L47twxXt0hkb68F70bXiL31MxsuoZtKFw==",
      "license": "Apache-2.0",
      "dependencies": {
        "wasm-feature-detect": "^1.2.11"
      }
    },
    "node_modules/@smallpen/background": {
      "resolved": "apps/background",
      "link": true
    },
    "node_modules/@smallpen/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/smallpen": {
      "resolved": "apps/npm-cli",
      "link": true
    },
    "node_modules/@smallpen/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@smallpen/desktop": {
      "resolved": "apps/desktop",
      "link": true
    },
    "node_modules/@smallpen/local-package": {
      "resolved": "packages/local-package",
      "link": true
    },
    "node_modules/@smallpen/penpot-adapter": {
      "resolved": "packages/penpot-adapter",
      "link": true
    },
    "node_modules/@smallpen/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/opentype.js": {
      "version": "2.0.0",
      "resolved": "https://registry.npmjs.org/opentype.js/-/opentype.js-2.0.0.tgz",
      "integrity": "sha512-kCyjv6xdDY1W/jLWZ/L3QhhTlKUqDZMQ5+Jdlw12b3dXkKNpYBqqlMMj0YDQPShWFTMwgZI1hG14kN3XUDSg/A==",
      "bin": {
        "ot": "bin/ot"
      }
    },
    "node_modules/wasm-feature-detect": {
      "version": "1.9.0",
      "resolved": "https://registry.npmjs.org/wasm-feature-detect/-/wasm-feature-detect-1.9.0.tgz",
      "integrity": "sha512-zonE+xlIIYtxPy++L24ow0hAD8CICb4+FgPyROd3buyXIqsJvUEDkBgfCCoXOd1Hu3DUr0GOfnPIdcGV+YpNaA==",
      "license": "Apache-2.0"
    },
    "packages/core": {
      "name": "@smallpen/core",
      "version": "0.1.0"
    },
    "packages/local-package": {
      "name": "@smallpen/local-package",
      "version": "0.1.0",
      "dependencies": {
        "@jsquash/webp": "1.5.0",
        "@smallpen/core": "0.1.0",
        "opentype.js": "2.0.0"
      }
    },
    "packages/penpot-adapter": {
      "name": "@smallpen/penpot-adapter",
      "version": "0.1.0",
      "dependencies": {
        "@smallpen/core": "0.1.0"
      }
    }
  }
}
