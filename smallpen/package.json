{
  "name": "@smallpen/workspace",
  "version": "0.1.0-alpha.12",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:skills": "node scripts/build-skills.mjs",
    "check:skills": "node scripts/build-skills.mjs --check",
    "build:web-capabilities": "node scripts/build-web-capabilities.mjs",
    "check:web-capabilities": "node scripts/build-web-capabilities.mjs --check",
    "build:cli": "node scripts/build-cli.mjs",
    "build:web": "node scripts/build-web.mjs",
    "pack:check": "npm pack --workspaces --dry-run --ignore-scripts",
    "test": "node scripts/prepare-renderer.mjs && node --test --test-concurrency=4 --test-timeout=120000",
    "test:ci": "node scripts/test-ci.mjs",
    "test:desktop": "node e2e/desktop-smoke.mjs",
    "test:e2e": "node e2e/package-workspace.mjs && node e2e/render-parity.mjs",
    "test:render-parity": "node e2e/render-parity.mjs"
  },
  "devDependencies": {
    "pngjs": "7.0.0"
  }
}
