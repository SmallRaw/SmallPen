(defn- real-snapshot []
  (-> {:manifest {:packageId "pkg_design_system" :name "Design System Fixture"}
       :formatCapabilities {:webProjection projection/format-capabilities}
       :runtime {:file "1c241d42-8fd3-56f0-958f-0eabe092adaf"
                 :pages {:scr_design_system "a1e50000-0000-4000-8000-000000000001"}
                 :designSystemPage "a1e50000-0000-4000-8000-000000000002"
                 :designSystem ds-ids
                 :designSystemRefs {:specimens (into {} (map (fn [s] [(keyword (:tokenId s)) s]) real-specimens))
                                    :tokenGroups real-groups
                                    :families []
                                    :pages []}
                 :components {}
                 :variants {}
                 :componentNodes {}
                 :nodes {}
                 :fonts {}}}))

(t/deftest real-refs-project-every-token-cell-onto-the-board
  (let [snapshot (real-snapshot)
        result (projection/project-snapshot snapshot {:file-id uuid/zero :project-id uuid/zero})
        page (get-in result [:file :data :pages-index (uuid/parse "a1e50000-0000-4000-8000-000000000002")])
        objects (:objects page)
        board-id (uuid/parse (:board ds-ids))]
    (doseq [s real-specimens]
      (let [shape-id (uuid/parse (:shape s))]
        (t/is (some? (get objects shape-id))
              (str "specimen missing from objects: " (:tokenId s) " " (:shape s)))
        (when-some [shape (get objects shape-id)]
          (t/is (= board-id (:parent-id shape))
                (str "specimen not adopted by board: " (:tokenId s)
                     " parent=" (:parent-id shape))))))
    (doseq [g real-groups]
      (let [header-id (uuid/parse (:header g))]
        (t/is (some? (get objects header-id))
              (str "group header missing: " (:setName g) "/" (:type g) " " (:header g)))))))
